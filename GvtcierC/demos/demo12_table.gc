ZiFu buf[32];

ZhengShu itoa(ZhengShu n) {
    ZhengShu i;
    ZhengShu neg;
    neg = 0;
    RuGuo (n < 0) {
        neg = 1;
        n = 0 - n;
    }
    i = 0;
    Dang (n > 0) {
        buf[i] = n % 10 + 48;
        n = n / 10;
        i = i + 1;
    }
    RuGuo (i == 0) {
        buf[i] = 48;
        i = i + 1;
    }
    RuGuo (neg == 1) {
        buf[i] = 45;
        i = i + 1;
    }
    ZhengShu j;
    ZhengShu k;
    j = 0;
    k = i - 1;
    Dang (j < k) {
        ZhengShu t;
        t = buf[j];
        buf[j] = buf[k];
        buf[k] = t;
        j = j + 1;
        k = k - 1;
    }
    buf[i] = 0;
    FanHui i;
}

ZhengShu main() {
    ZhengShu i;
    ZhengShu j;
    XunHuan (i = 1; i <= 9; i = i + 1) {
        XunHuan (j = 1; j <= i; j = j + 1) {
            itoa(i * j);
            DaYin(buf);
            DaYin(" ");
        }
        DaYin("|");
    }
    FanHui 0;
}
